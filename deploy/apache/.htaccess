# Joran · Apache configuration. Copy this file into _site/ before uploading
# (or into content/static/.htaccess so every build includes it).
# Requires mod_rewrite, mod_headers, mod_expires and mod_deflate (enabled on most shared hosts).

ErrorDocument 404 /404.html
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2

# Always HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # CSS, JS and generated images carry a version (?v=…) or a hash in their name: cache them for a year.
  <FilesMatch "\.(css|js|woff2|webp|avif|jpg|jpeg|png|gif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages and feeds change at every build: always revalidate.
  <FilesMatch "\.(html|xml|json|webmanifest|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/atom+xml application/manifest+json image/svg+xml
</IfModule>
