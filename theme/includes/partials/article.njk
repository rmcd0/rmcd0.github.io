{#- Joran · a post: title, meta line, hero image, text, translations, newer/older links. -#}
{%- set nb = collections.posts | neighbours(page) -%}
<article class="post h-entry"{% if lang != uiLang %} lang="{{ lang }}"{% endif %}>
  <header class="post-head">
    {%- if draft %}<p class="draft-flag">{{ "post.draft" | t }}</p>{% endif %}
    <h1 class="p-name">{{ title }}</h1>
    {%- if description and showDescription %}<p class="lead p-summary">{{ description }}</p>{% endif %}
    <p class="meta">
      <time class="dt-published" datetime="{{ page.date | isoDate }}">{{ page.date | dateFmt }}</time>
      {%- if updated %}<span>{{ "post.updated" | t }} <time class="dt-updated" datetime="{{ updated | isoDate }}">{{ updated | dateFmt }}</time></span>{% endif %}
      {%- if site.features.readingTime %}<span>{{ "post.minRead" | t({ n: (content | readingTime) }) }}</span>{% endif %}
      <span class="lang-badge" data-lang="{{ lang }}" title="{{ lang | languageName }}">{{ lang | upper }}</span>
      <span>{{ type | typeLabel }}</span>
      {%- for tg in tags %}<a class="u tag" href="{{ ('/tags/' + (tg | slug) + '/') | localeUrl }}">#<span class="p-category">{{ tg }}</span></a>{% endfor %}
    </p>
  </header>
  {%- if image %}
  <figure class="figure hero">
    <img src="{{ image }}" alt="{{ imageAlt }}" loading="eager" fetchpriority="high" sizes="(min-width: 1000px) 760px, 100vw">
    {%- if imageCaption %}<figcaption>{{ imageCaption | mdInline | safe }}</figcaption>{% endif %}
  </figure>
  {%- endif %}
  <div class="prose e-content">
{{ content | safe }}
  </div>
  <footer class="post-foot">
    {%- set alternates = collections.translations[translationKey] if translationKey else [] %}
    {%- if alternates.length > 1 %}
    <p class="also">{{ "post.translations" | t }}
    {%- for a in alternates %}{% if a.url != page.url %} <a class="u" href="{{ a.url }}" hreflang="{{ a.lang }}" lang="{{ a.lang }}">{{ a.title }} ({{ a.lang | upper }})</a>{% endif %}{% endfor %}</p>
    {%- endif %}
    {%- if alsoOn %}<p class="also"><a class="u" href="{{ alsoOn }}" rel="noopener">{{ "post.alsoOn" | t({ site: (alsoOn | host) }) }}</a></p>{% endif %}
    {#- for IndieWeb tools: address and author of the post (hidden: the page and the sidebar already show them) #}
    <a class="u-url" href="{{ page.url }}" hidden>{{ "post.permalink" | t }}</a>
    <span class="p-author h-card" hidden><a class="u-url p-name" href="{{ site.author.url or ('/' | localeUrl) }}">{{ site.author.name or site.title }}</a></span>
  </footer>
</article>
{%- if nb.newer or nb.older %}
<nav class="pager" aria-label="{{ 'post.morePosts' | t }}">
  {%- if nb.older %}<a class="pager-link" href="{{ nb.older.url }}" rel="prev"><small>‹ {{ "post.older" | t }}</small><b>{{ nb.older.data.title }}</b></a>{% else %}<span></span>{% endif %}
  {%- if nb.newer %}<a class="pager-link next" href="{{ nb.newer.url }}" rel="next"><small>{{ "post.newer" | t }} ›</small><b>{{ nb.newer.data.title }}</b></a>{% endif %}
</nav>
{%- endif %}
