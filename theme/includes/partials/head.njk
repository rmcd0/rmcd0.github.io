{#- Joran · <head>: meta, SEO, social cards, feeds, styles. -#}
{%- set pageTitle = title or (titleKey | t if titleKey) -%}
{%- set fullTitle = (pageTitle + " · " + site.title) if (pageTitle and page.url != "/" and page.url != (uiLang | langPrefix) + "/") else site.title -%}
{%- set desc = description or (site.description | l10n) -%}
{%- set canonicalUrl = canonical or (page.url | htmlBaseUrl(site.url)) -%}
{%- set shareImage = image or site.ogImage or site.avatar -%}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ fullTitle }}</title>
  {%- if desc %}
  <meta name="description" content="{{ desc }}">
  {%- endif %}
  <link rel="canonical" href="{{ canonicalUrl }}">
  {%- if site.noindex or noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {%- set alternates = collections.translations[translationKey] if translationKey else [] %}
  {%- if alternates.length > 1 %}
  {%- for a in alternates %}
  <link rel="alternate" hreflang="{{ a.lang }}" href="{{ a.url | htmlBaseUrl(site.url) }}">
  {%- endfor %}
  {%- elif pagination and uiLanguages.length > 1 and pageLang %}
  {%- for l in uiLanguages %}
  <link rel="alternate" hreflang="{{ l.lang }}" href="{{ (l.prefix + (page.url | replace((uiLang | langPrefix) + '/', '/'))) | htmlBaseUrl(site.url) }}">
  {%- endfor %}
  {%- endif %}
  <meta name="color-scheme" content="light dark">
  <meta name="generator" content="{{ eleventy.generator }} · Joran {{ joran.version }}">
  {%- if site.author.name %}
  <meta name="author" content="{{ site.author.name }}">
  {%- endif %}

  {#- Open Graph & social cards #}
  <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ pageTitle or site.title }}">
  {%- if desc %}
  <meta property="og:description" content="{{ desc }}">
  {%- endif %}
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:locale" content="{{ (site.locales[lang] or lang) | replace('-', '_') }}">
  {%- if shareImage %}
  <meta property="og:image" content="{{ shareImage | ogImage }}">
  {%- if image and imageAlt %}
  <meta property="og:image:alt" content="{{ imageAlt }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  {%- endif %}
  {%- if isPost %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  {%- if updated %}
  <meta property="article:modified_time" content="{{ updated | isoDate }}">
  {%- endif %}
  {%- for tg in tags %}
  <meta property="article:tag" content="{{ tg }}">
  {%- endfor %}
  {%- endif %}

  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ site.feed.path }}">
  <link rel="icon" href="{{ site.favicon }}"{% if site.favicon.endsWith('.svg') %} type="image/svg+xml"{% endif %}>
  <link rel="manifest" href="/manifest.webmanifest">
  {%- for m in site.socials %}{% if m.url and m.verify %}
  <link rel="me" href="{{ m.url }}">
  {%- endif %}{% endfor %}

  <link rel="preload" href="/assets/joran/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/joran/joran.css' | asset }}">
  {%- if customCss %}
  <link rel="stylesheet" href="{{ '/assets/custom.css' | asset }}">
  {%- endif %}
  <script>try{var m=localStorage.getItem("joran-mode");if(m)document.documentElement.dataset.mode=m}catch(e){}document.documentElement.classList.add("js")</script>
  {% include "partials/jsonld.njk" %}
